{
  "name": "tradeasy",
  "version": "0.23.2",
  "description": "Chrome MV3 extension: trade from Axiom/GMGN with your own hot wallet via Helius Sender",
  "scripts": {
    "build": "node build.mjs",
    "test:offline": "esbuild test/harness.mjs --bundle --platform=node --format=cjs --outfile=test/.build/harness.cjs --log-level=warning && node test/.build/harness.cjs",
    "test:e2e": "node build.mjs && node test/e2e.cjs",
    "simexport": "esbuild test/simexport.mjs --bundle --platform=node --format=cjs --outfile=test/.build/simexport.cjs --log-level=warning && node test/.build/simexport.cjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^2.0.0",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@raydium-io/raydium-sdk-v2": "^0.2.76-alpha",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  },
  "private": true
}
